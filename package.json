{
  "name": "novelai-story-seo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run test && npm run check:experience && npm run check && npm run build && npm run verify:pages",
    "check:experience": "node scripts/verify-experience-contracts.mjs",
    "verify:pages": "node scripts/verify-built-pages.mjs",
    "daily:state": "node scripts/check-daily-run-state.mjs",
    "daily:coord": "node scripts/run-node-supervised.mjs 1200000 scripts/manage-daily-coordination.mjs",
    "release:verify": "node scripts/verify-live-release.mjs",
    "growth:check": "node scripts/check-growth-readiness.mjs",
    "growth:probe": "node scripts/probe-playworlds-callback.mjs",
    "growth:probe:legacy-novelai": "node scripts/probe-novelai-callback.mjs",
    "growth:collect": "node scripts/collect-growth-portfolio.mjs",
    "trends:configure": "node scripts/configure-google-trends.mjs",
    "trends:check": "node scripts/collect-google-trends.mjs --check",
    "trends:collect": "node scripts/collect-google-trends.mjs",
    "feedback:sync": "node scripts/sync-workbench-feedback.mjs",
    "research:build": "npm run feedback:sync && node scripts/build-free-research-report.mjs",
    "research:publish": "node scripts/run-node-supervised.mjs 600000 scripts/publish-reviewed-page.mjs"
  },
  "dependencies": {
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/microfrontends": "2.4.0",
    "ai": "^6.0.83",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "google-auth-library": "^10.9.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "next-seo": "^7.2.0",
    "postcss": "^8.5.20",
    "radix-ui": "^1.6.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.20",
    "sharp": "0.35.0"
  }
}
