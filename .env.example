# Public deployment configuration
NEXT_PUBLIC_SITE_URL=https://lorelens.novelai.ai
NOVELAI_DESTINATION_URL=https://www.novelai.ai/zh-CN/
# Public GA4 Measurement ID (starts with G-). Leave blank to disable Google Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Private workbench, automation, and callback authentication
# WORKBENCH_PASSWORD is for interactive human access only.
# SEO_AUTOMATION_TOKEN is a machine-only bearer token; generate at least 32 random bytes.
# ATTRIBUTION_SECRET must also exist in the NovelAI server environment.
# CRON_SECRET protects only the Vercel landing-coverage rollover route;
# its daily 0 16 * * * UTC run (Shanghai 00:00) closes the previous day and opens the current.
# Content research and publishing remain on the local Codex schedule.
WORKBENCH_PASSWORD=
SEO_AUTOMATION_TOKEN=
ATTRIBUTION_SECRET=
CRON_SECRET=

# Durable attribution store (Upstash Redis Marketplace integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Immutable UTC ISO-8601 rollout watermark for first-party landing analytics.
# A period is readable only after this watermark and only when every complete
# Shanghai day has rollover-written start and end checkpoints.
FIRST_PARTY_LANDING_ANALYTICS_STARTED_AT=

# Optional full-period fallback: Vercel Web Analytics API (server-only access token)
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=prj_Wcu8wFAePajKbNMIKl2eUd2O3K4p
VERCEL_ANALYTICS_TEAM_ID=team_KY6ZZwNyFhuy7ORN6EKIbfVr

# Google Search Console API (server-only service account)
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://lorelens.novelai.ai/

# Google Trends official BigQuery public dataset (server-only service account)
# Grant only BigQuery Job User on the billing project; the source tables are public.
# The same private key signs compact collection digests; only its public-key
# fingerprint and signature enter artifacts. Never expose these variables client-side.
GOOGLE_TRENDS_BIGQUERY_PROJECT_ID=
GOOGLE_TRENDS_BIGQUERY_CLIENT_EMAIL=
GOOGLE_TRENDS_BIGQUERY_PRIVATE_KEY=

# Optional second durable sink for conversion events
ATTRIBUTION_SINK_URL=
ATTRIBUTION_SINK_TOKEN=

# Optional CLI override for private funnel collection
SEO_REPORT_SITE_URL=https://lorelens.novelai.ai

# Optional remote report and feedback persistence
GITHUB_REPORTS_TOKEN=
GITHUB_REPORTS_REPO=lium53492-rgb/seo
GITHUB_REPORTS_BRANCH=main
